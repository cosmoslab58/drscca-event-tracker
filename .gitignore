.env

# Was ".log", which matches only a file named exactly that -- the actual log
# files were never ignored.
*.log
nohup.out

# Runtime event/audit data, plus the lock file the writer leaves behind.
*.ndjson
*.ndjson.lock

__pycache__/
*.pyc
venv/
.venv/

# Local copies taken before editing a compose file on the host.
*.bak

# curl cookie jar from manual API poking. May hold a live session cookie --
# must never be committed.
cookies.txt

# Nightly .xlsx copies of the Google Sheets (backup_sheets.py)
data/backups/
data/*.lock
data/sheet_cache.sqlite*
# Runtime data (sign-in codes hold email addresses): never commit; programs.json is the one tracked file
data/*.json
!data/programs.json
data/qbo-refresh.json
data/qbo-last-run.json
data/*.tmp
data/officials-queue.json
data/officials-done.json
data/role-access.json
# Public records database, built off the server (see records.py)
data/records.db
