# The admin changes a role's holder on the apps' Officials page, which writes data/officials-queue.json;
# this applies it (officials.json + the drscca.org Google Groups). systemctl --user enable --now drscca-officials.path
[Unit]
Description=DRSCCA apps: officials-list changes made in the app

[Path]
PathChanged=%h/projects/event_drscca_app/data/officials-queue.json
Unit=drscca-officials.service

[Install]
WantedBy=default.target
