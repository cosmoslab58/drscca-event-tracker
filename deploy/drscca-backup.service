# Nightly .xlsx copy of every Google Sheet into data/backups/ (keeps 60 days).
# Install: copy the drscca-backup*.service and .timer files to ~/.config/systemd/user/, set the container
# name below (CONTAINER_NAME in .env), then: systemctl --user daemon-reload && systemctl --user enable --now drscca-backup.timer
[Unit]
Description=DRSCCA apps: nightly backup of the Google Sheets
OnFailure=drscca-backup-failed.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec event-drscca python backup_sheets.py
