# The apps' "Refresh from QuickBooks" button writes data/qbo-refresh.json; this runs the sync right away.
# Install next to drscca-qbo.*: systemctl --user enable --now drscca-qbo-refresh.path
[Unit]
Description=DRSCCA apps: QuickBooks refresh asked for in the app

[Path]
PathChanged=%h/projects/event_drscca_app/data/qbo-refresh.json
Unit=drscca-qbo-refresh.service

[Install]
WantedBy=default.target
