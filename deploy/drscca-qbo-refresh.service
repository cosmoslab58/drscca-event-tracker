[Unit]
Description=DRSCCA apps: QuickBooks sync asked for with the Refresh button
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/event_drscca_app
EnvironmentFile=%h/.secrets/qbo.env
Environment=PATH=/usr/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/projects/event_drscca_app/venv/bin/python tools/qbo_nightly.py --manual
TimeoutStartSec=15min
