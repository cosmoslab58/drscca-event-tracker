# Copy to .env and fill in. .env is gitignored: never commit it.

# --- Region ---
SCCA_REGION_ACRONYM="DRSCCA"
SCCA_REGION_NAME="Detroit Region SCCA"
EVENT_CODE_PREFIX="DR"
PROGRAM_DIRECTORS_TEXT="For use by DRSCCA program directors"
TIMEZONE=US/Eastern
PROGRAMS_FILE=data/programs.json

# --- Web ---
# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# The shared password everyone signs in with
APP_PASSWORD=
PORT=5858
HOST=0.0.0.0
DEBUG=False
# Optional, for running more than one copy on one host
CONTAINER_NAME=event-drscca
HOST_PORT=5858

# --- Data: Google Sheets in the DRSCCA Apps Shared Drive ---
STORAGE_BACKEND=sheets
# Path of the service account key ON THE HOST; compose mounts it into the container
GOOGLE_SA_KEY_HOST=/path/to/google-sa.json
# Path INSIDE the container (leave as is when using docker-compose.prod.yml)
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-sa.json
# Spreadsheet and folder IDs: the long ID in each Google URL
REGISTRY_SHEET_ID=
LEDGER_SHEET_ID=
BUDGETS_SHEET_ID=
BUDGETS_FILES_FOLDER_ID=
FUNDS_SHEET_ID=
FUNDS_RECEIPTS_FOLDER_ID=
PLAN_SHEET_ID=
OPERATIONS_SHEET_ID=
OPERATIONS_DOCS_FOLDER_URL=
INVOICES_SHEET_ID=
INVOICES_PDF_FOLDER_ID=

# --- Officials (who approves what); see officials.example.json ---
# Path ON THE HOST; compose mounts it read-only
OFFICIALS_HOST=/path/to/officials.json

# --- Email ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# Leave user and password empty only for a relay that accepts this host without login
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Where new-event notices go, and the fallback treasurer address
NOTIFICATION_EMAIL=treasurer@drscca.org
